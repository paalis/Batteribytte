{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/film",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/film/(.*)",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v1",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v1/(.*)",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
